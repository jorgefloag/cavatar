# Neon Postgres — from the Neon dashboard (pooled connection string)
DATABASE_URL=

# Clerk — from the Clerk Dashboard's API Keys page
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Admin panel access — comma-separated list of emails allowed into /admin/*
ADMIN_EMAILS=

# Resend — from the Resend Dashboard's API Keys page. Used to email the one-time
# claim-setup link (see lib/claims/issue-setup-token.ts). Sending domain must be
# verified in Resend (SPF/DKIM/DMARC) before real emails will deliver.
RESEND_API_KEY=

# Base URL used to build the claim-setup link sent by email
# (e.g. http://localhost:3000 in dev, https://www.cavatarcr.com in production)
NEXT_PUBLIC_APP_URL=
