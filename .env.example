# Neon Postgres — from the Neon dashboard (pooled connection string)
DATABASE_URL=

# Clerk — from the Clerk Dashboard's API Keys page
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Admin panel access — comma-separated list of emails allowed into /admin/*
ADMIN_EMAILS=

# Where operational notifications go (new pending claim/verified request,
# the daily digest — see lib/email/send-admin-*.ts and app/api/cron/).
# Deliberately separate from ADMIN_EMAILS: that one gates who can log into
# /admin, this one is just an inbox for alerts and doesn't need to match.
ADMIN_NOTIFICATION_EMAIL=

# Resend — from the Resend Dashboard's API Keys page. Used to email the one-time
# claim-setup link (see lib/claims/issue-setup-token.ts) and admin notifications
# (see lib/email/send-admin-*.ts). Sending domain must be verified in Resend
# (SPF/DKIM/DMARC) before real emails will deliver.
RESEND_API_KEY=

# Shared secret Vercel Cron sends as `Authorization: Bearer $CRON_SECRET` when
# it calls app/api/cron/daily-digest — without this, that endpoint would be a
# public URL anyone could hit to trigger (or spam) the admin digest. Must be
# set to the same value in the Vercel project's env vars.
CRON_SECRET=

# Base URL used to build the claim-setup link sent by email
# (e.g. http://localhost:3000 in dev, https://www.cavatarcr.com in production)
NEXT_PUBLIC_APP_URL=

# Shown on /claim so people can pay the ₡5,000/año claim fee. Both are read
# server-side only (app/claim/page.tsx) and passed as props to the client
# form — do NOT rename with a NEXT_PUBLIC_ prefix, that's handled deliberately.
# SINPE_PHONE_NUMBER: local format as you want it displayed, e.g. 8888-8888
# WHATSAPP_PHONE_NUMBER: wa.me format — digits only, with country code, no
#   "+" or spaces, e.g. 50688888888
SINPE_PHONE_NUMBER=
WHATSAPP_PHONE_NUMBER=
